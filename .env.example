NODE_ENV=development
PORT=4000

# --- Base de datos ---
# Opción A (local): variables sueltas
DB_HOST=localhost
DB_PORT=5432
DB_NAME=atencion_medica
DB_USER=postgres
DB_PASSWORD=

# Opción B (nube / Supabase): una sola cadena. Si está definida, tiene prioridad sobre las de arriba.
# Usa la cadena "Session pooler" (puerto 5432) de Supabase > Connect.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# DB_POOL_MAX=10

# --- Auth ---
JWT_SECRET=changeme
JWT_EXPIRES_IN=7d

# --- CORS: orígenes del frontend separados por comas ---
CORS_ORIGIN=http://localhost:5173
# Aceptar también las vistas previas de Vercel del proyecto indicado
# CORS_PERMITIR_PREVIEWS_VERCEL=true
# VERCEL_PROYECTO=medgo-front

# Detrás de un proxy (Render): 1
# TRUST_PROXY=1

# --- Tracking en tiempo real ---
RADIO_LLEGADA_METROS=50

# --- Notificaciones y recordatorios ---
TZ_APP=America/Lima
MINUTOS_AVISO_SIN_MEDICO=10

# --- Copias de seguridad (JSON en Back/backups) ---
BACKUP_INTERVALO_HORAS=24
BACKUP_RETENER=14
# BACKUP_DIR=./backups
